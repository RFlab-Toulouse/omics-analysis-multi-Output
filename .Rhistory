data(HouseVotes84, package = "mlbench")
model <- naiveBayes(Class ~ ., data = HouseVotes84)
e1071:::predict.naiveBayes(model, HouseVotes84[1:10,])
e1071:::predict.naiveBayes(model, HouseVotes84[1:10,], type = "raw")
pred <- e1071:::predict.naiveBayes(model, HouseVotes84)
table(pred, HouseVotes84$Class)
## using laplace smoothing:
model <- naiveBayes(Class ~ ., data = HouseVotes84, laplace = 3)
pred <- e1071:::predict.naiveBayes(model, HouseVotes84[,-1])
table(pred, HouseVotes84$Class)
pred
pred %>% dim()
pred %>% length()
str(HouseVotes84)
